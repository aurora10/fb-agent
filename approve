#!/usr/bin/env bash
# Approve drafts: ./approve 1 3 07   -> moves to approved/ as post_NN.json
cd "$(dirname "$0")"
mkdir -p approved drafts        # approved/ is gitignored, so absent on a fresh clone
for n in "$@"; do
  n=$(printf "%02d" "$((10#$n))")
  f="drafts/draft_$n.json"
  [ -f "$f" ] || { echo "!! no drafts/draft_$n.json"; continue; }
  mv "$f" "approved/post_$n.json"
  echo "[ok] approved post_$n  (image: images/$n.png)"
done
