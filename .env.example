# Copy to .env and fill in.  .env is gitignored, and the tooling chmod 600s it.
# Only the top block is needed for content generation; the FB_* block is needed to publish.

# --- text generation (OpenAI) ---------------------------------------------
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional. Defaults to gpt-5.4-mini.
# Run `./scripts/fb_plan.py --models` to list what your key can use.
OPENAI_MODEL=

# --- image generation -----------------------------------------------------
# openai (default, costs per image) or pollinations (free, no key)
IMAGE_PROVIDER=openai
# Defaults to gpt-image-2. Also available: gpt-image-1.5, gpt-image-2.5-flare,
# gpt-image-2.5-sunburst, gpt-image-1-mini.
OPENAI_IMAGE_MODEL=gpt-image-2
# 1024x1024 | 1024x1536 | 1536x1024
OPENAI_IMAGE_SIZE=1024x1024
# low | medium | high | xhigh | max | auto   <- the main cost lever
OPENAI_IMAGE_QUALITY=medium
# png | jpeg | webp
OPENAI_IMAGE_FORMAT=jpeg

# --- site (only needed for a second Page) ---------------------------------
# Leave unset and the repo root is the site (the original single-Page layout).
# SITE=crewnetusa      reads sites/crewnetusa/{.env,data,drafts,images,...}
# BRAND_URL is used only by the fallback CSV export.
BRAND_URL=https://constructief-bouw.be

# --- your Meta app: Settings -> Basic -------------------------------------
FB_APP_ID=
FB_APP_SECRET=

# --- filled in automatically by `./scripts/fb_api.py token` ---------------
FB_PAGE_ID=
FB_PAGE_TOKEN=

# --- needed only once, for `./scripts/fb_api.py token` --------------------
# Paste a SHORT-LIVED user token from the Graph API Explorer here, run `token`,
# then it is blanked for you. (FB_LONG_USER_TOKEN is also written there.)
FB_USER_TOKEN=
